## 四、MySQL 数据库设计

### 4.1 权限事件表（事件溯源）

```sql
CREATE TABLE doc_permission_events (
    id           BIGINT AUTO_INCREMENT PRIMARY KEY,
    doc_id       VARCHAR(256) NOT NULL COMMENT '文档 ES _id 或 source_name',
    action       ENUM('GRANT','REVOKE','HANDLER','VISIBILITY_CHANGE') NOT NULL,
    target_type  ENUM('USER','DEPT','GROUP') NOT NULL,
    target_value VARCHAR(128) NOT NULL COMMENT '用户ID / 部门编码 / 群组名',
    operator_id  VARCHAR(64)  NOT NULL,
    created_at   DATETIME(3)  NOT NULL DEFAULT CURRENT_TIMESTAMP(3),
    INDEX idx_doc (doc_id),
    INDEX idx_time (created_at)
) COMMENT='文档权限变更事件溯源';
```

### 4.2 权限群组表（RBAC）

```sql
CREATE TABLE permission_groups (
    id          BIGINT AUTO_INCREMENT PRIMARY KEY,
    group_code  VARCHAR(64)  UNIQUE NOT NULL COMMENT '群组唯一标识',
    group_name  VARCHAR(128) NOT NULL,
    created_by  VARCHAR(64),
    created_at  DATETIME DEFAULT CURRENT_TIMESTAMP
) COMMENT='权限群组定义';

CREATE TABLE permission_group_members (
    id          BIGINT AUTO_INCREMENT PRIMARY KEY,
    group_code  VARCHAR(64)  NOT NULL,
    dept_code   VARCHAR(32)  COMMENT '部门编码（12位）',
    user_id     VARCHAR(64)  COMMENT '用户ID（可选）',
    INDEX idx_group (group_code),
    INDEX idx_dept (dept_code)
) COMMENT='群组成员（部门或用户）';
```

### 4.3 文档版本记录表（历史追踪）

```sql
CREATE TABLE doc_version_history (
    id           BIGINT AUTO_INCREMENT PRIMARY KEY,
    source_name  VARCHAR(256) NOT NULL COMMENT '文档名称',
    doc_version  INT          NOT NULL,
    content_hash VARCHAR(64)  COMMENT '正文前2000字MD5，用于去重',
    operator_id  VARCHAR(64),
    chunk_count  INT          COMMENT '该版本切片数',
    created_at   DATETIME(3)  NOT NULL DEFAULT CURRENT_TIMESTAMP(3),
    UNIQUE KEY uk_source_ver (source_name, doc_version),
    INDEX idx_source (source_name)
) COMMENT='文档版本历史记录';
```

### 4.4 部门组织树表

```sql
CREATE TABLE dept_tree (
    dept_code    VARCHAR(32)  PRIMARY KEY COMMENT '12位行政区划编码',
    dept_name    VARCHAR(128) NOT NULL,
    dept_l2      VARCHAR(4)   COMMENT '省级前缀',
    dept_l4      VARCHAR(8)   COMMENT '市级前缀',
    dept_l6      VARCHAR(12)  COMMENT '区县级前缀',
    dept_l9      VARCHAR(18)  COMMENT '乡镇级前缀',
    dept_level   TINYINT      COMMENT '1省 2市 3区 4乡 5机构',
    parent_code  VARCHAR(32),
    is_active    TINYINT(1) DEFAULT 1,
    INDEX idx_l2 (dept_l2),
    INDEX idx_l6 (dept_l6)
) COMMENT='行政区划组织树';
```

