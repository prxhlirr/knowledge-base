{
  "index_templates": [
    {
      "index_template": {
        "composed_of": [],
        "index_patterns": [
          "kb_*"
        ],
        "template": {
          "mappings": {
            "properties": {
              "content": {
                "analyzer": "ik_max_word",
                "fields": {
                  "keyword": {
                    "ignore_above": 256,
                    "type": "keyword"
                  }
                },
                "type": "text"
              },
              "data_source": {
                "type": "keyword"
              },
              "doc_title": {
                "analyzer": "ik_max_word",
                "fields": {
                  "keyword": {
                    "type": "keyword"
                  }
                },
                "type": "text"
              },
              "owner_dept_id": {
                "type": "keyword"
              },
              "security_level": {
                "type": "integer"
              },
              "vector": {
                "dims": 1024,
                "index": true,
                "index_options": {
                  "ef_construction": 100,
                  "m": 16,
                  "type": "hnsw"
                },
                "similarity": "cosine",
                "type": "dense_vector"
              },
              "visible_depts": {
                "type": "keyword"
              }
            }
          }
        }
      },
      "name": "kb_template"
    },
    {
      "index_template": {
        "composed_of": [],
        "index_patterns": [
          "kb_document_*"
        ],
        "priority": 100,
        "template": {
          "aliases": {
            "kb_document": {}
          },
          "mappings": {
            "properties": {
              "acl_tokens": {
                "type": "keyword"
              },
              "chunk_granularity": {
                "type": "keyword"
              },
              "colloquial_vector": {
                "dims": 1024,
                "index": false,
                "type": "dense_vector"
              },
              "content": {
                "analyzer": "ik_max_word",
                "search_analyzer": "ik_smart",
                "type": "text"
              },
              "index_code": {
                "type": "keyword"
              },
              "keywords": {
                "type": "keyword"
              },
              "metadata": {
                "properties": {
                  "access_groups": {
                    "type": "keyword"
                  },
                  "acl_tokens": {
                    "type": "keyword"
                  },
                  "chunk_id": {
                    "type": "integer"
                  },
                  "data_source": {
                    "type": "keyword"
                  },
                  "dept_code_full": {
                    "type": "keyword"
                  },
                  "dept_l2": {
                    "type": "keyword"
                  },
                  "dept_l4": {
                    "type": "keyword"
                  },
                  "dept_l6": {
                    "type": "keyword"
                  },
                  "dept_l9": {
                    "type": "keyword"
                  },
                  "doc_version": {
                    "type": "integer"
                  },
                  "document_number": {
                    "type": "keyword"
                  },
                  "dynamic_meta": {
                    "dynamic": false,
                    "type": "object"
                  },
                  "index_code": {
                    "type": "keyword"
                  },
                  "is_latest": {
                    "type": "boolean"
                  },
                  "owner": {
                    "type": "keyword"
                  },
                  "owner_dept_id": {
                    "type": "keyword"
                  },
                  "owner_unit_code": {
                    "type": "keyword"
                  },
                  "permission_version": {
                    "type": "long"
                  },
                  "publish_time": {
                    "format": "yyyy-MM-dd||epoch_millis",
                    "type": "date"
                  },
                  "quality_score": {
                    "type": "float"
                  },
                  "search_queries": {
                    "type": "text"
                  },
                  "section_path": {
                    "analyzer": "ik_smart",
                    "fields": {
                      "keyword": {
                        "type": "keyword"
                      }
                    },
                    "type": "text"
                  },
                  "source": {
                    "type": "keyword"
                  },
                  "source_index": {
                    "type": "keyword"
                  },
                  "tags": {
                    "type": "text"
                  },
                  "tags_kw": {
                    "type": "keyword"
                  },
                  "title": {
                    "analyzer": "ik_max_word",
                    "fields": {
                      "keyword": {
                        "type": "keyword"
                      }
                    },
                    "search_analyzer": "ik_smart",
                    "type": "text"
                  },
                  "updated_by": {
                    "type": "keyword"
                  },
                  "uploader_id": {
                    "type": "keyword"
                  },
                  "version_at": {
                    "format": "epoch_millis",
                    "type": "date"
                  },
                  "visibility": {
                    "type": "keyword"
                  },
                  "visible_unit_codes": {
                    "type": "keyword"
                  }
                }
              },
              "owner_unit_code": {
                "type": "keyword"
              },
              "parent_chunk_id": {
                "type": "keyword"
              },
              "permission_version": {
                "type": "long"
              },
              "source_index": {
                "type": "keyword"
              },
              "sparse_vector": {
                "type": "rank_features"
              },
              "vector": {
                "dims": 1024,
                "index": true,
                "similarity": "cosine",
                "type": "dense_vector"
              },
              "visible_unit_codes": {
                "type": "keyword"
              }
            }
          },
          "settings": {
            "index": {
              "analysis": {
                "analyzer": {
                  "ik_max_word": {
                    "tokenizer": "ik_max_word",
                    "type": "custom"
                  },
                  "ik_smart": {
                    "tokenizer": "ik_smart",
                    "type": "custom"
                  }
                }
              },
              "number_of_replicas": "0",
              "number_of_shards": "1"
            }
          }
        }
      },
      "name": "kb_document_template"
    }
  ]
}