# ─────────────────────────────────────────────────────────────
# 知识库项目通用 .gitattributes 配置
# ─────────────────────────────────────────────────────────────

# 默认对所有文本文件启用自动换行符检测
# 这样 Git 会智能判断哪些是文本，哪些是二进制
* text=auto

# ═══ 核心代码与脚本统一换行符为 LF ═══
# 彻底消除 Windows 与 Linux 换行符（CRLF vs LF）在多人协作和容器化部署时的运行故障
*.sh text eol=lf
*.py text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.md text eol=lf

# ═══ Windows 平台专属脚本强制 CRLF ═══
# Windows 批处理与 PowerShell 脚本需要保持 CRLF 换行符以确保在 Windows 终端中正常执行
*.bat text eol=crlf
*.ps1 text eol=crlf
