@echo off
chcp 65001 >nul
title 停止控制中心 - Knowledge Base
echo ===================================================
echo   项目停止脚本
echo   注意：本脚本会自动停止 Docker 服务，
echo   但 AI服务/Java服务/前端 窗口属于独立进程，
echo   请直接在各自的弹窗中按 Ctrl+C，然后关闭窗口即可。
echo ===================================================
echo.

:: 1. 停止并移除 Docker 容器 (可选不移除卷)
echo [1/1] 正在停止基础设施容器...
docker-compose down
echo 容器已停止。
echo.

echo ===================================================
echo 基础设施已关闭，请手动关闭刚才弹开的服务日志控制台。
echo ===================================================
pause
