# ===========================================================
# AI Service 环境变量配置模板
# 离线部署时：复制本文件为 .env，按实际情况修改
# ===========================================================

# ── LLM 大模型接入（Ollama 本地服务）─────────────────────────
# Ollama OpenAI 兼容接口地址，离线环境改为实际服务器 IP
LLM_API_URL=http://127.0.0.1:11434/v1/chat/completions

# LLM 通用模型（意图改写）
LLM_MODEL=qwen2.5:7b

# QA 生成专用模型；未设置时默认回退 qwen2.5:7b
QA_LLM_MODEL=qwen2.5:7b
QA_LLM_MAX_TOKENS=256
LLM_SEND_ENABLE_THINKING=true
PDF_PARSE_MIN_COVERAGE_TO_INDEX=0.5
PDF_PARSE_FULL_COVERAGE_THRESHOLD=0.98
ES_BULK_MAX_FAILURE_RATIO_TO_INDEX=0.05

# ── PaddleOCR 离线模型目录 ─────────────────────────────────
# 扫描件 PDF 需要以下子目录齐全，离线严格模式会在缺失时快速失败，避免运行时访问公网下载模型：
#   ch_PP-OCRv4_det_infer/
#   ch_PP-OCRv4_rec_infer/
#   ch_ppocr_mobile_v2.0_cls_infer/
#   ch_ppstructure_mobile_v2.0_SLANet_infer/
#   picodet_lcnet_x1_0_fgd_layout_infer/
PADDLE_OCR_MODEL_DIR=/app/models/paddle_ocr
PADDLE_OCR_OFFLINE_STRICT=true
OCR_USE_GPU=false
OCR_RENDER_DPI=220
OCR_MIN_RENDER_DPI=150
OCR_MAX_RENDER_PIXELS=6000000

# HyDE 专用模型（假设文档生成，建议 7B 及以上）
HYDE_LLM_MODEL=qwen2.5:7b

# LLM Reranker 专用模型（语义重排打分，必须 7B 及以上）
RERANKER_LLM_MODEL=qwen2.5:7b

# ── ONNX 模型根目录（绝对路径）──────────────────────────────
# 目录结构（不需要修改子路径，model_manager.py 自动拼接）：
#   <MODEL_BASE_PATH>/
#     bge-m3/
#       model.onnx           ← BGE-M3 FP32 嵌入模型
#       model_int8.onnx      ← BGE-M3 INT8 量化模型（优先使用）
#       tokenizer.json       ← 分词器配置
#       tokenizer_config.json
#     bge-reranker-v2-m3/
#       onnx/
#         model.onnx         ← Reranker FP32
#         model_int8.onnx    ← Reranker INT8（优先使用）
#       tokenizer.json
#
# Windows 示例：D:/models/onnx_native
# Linux 示例：/opt/kb-models/onnx_native
MODEL_BASE_PATH=../models/onnx_native

# ── CPU 推理线程数（无 GPU 时生效，建议 = 物理核心数）──────────
AI_CPU_THREADS=16

# ── GPU 设备 ID（多 GPU 时指定，单 GPU 保持 0）────────────────
ORT_CUDA_DEVICE_ID=0

# ── PostgreSQL 连接（操作日志写库，与 Java 侧共用同一 PG 实例）──
# AI 服务通过此配置写入 sys_operation_log 表实现双端审计
PG_HOST=localhost
PG_PORT=5432
PG_DB=knowledge_base
PG_USER=postgres
PG_PASSWORD=liyz

# ── 操作日志截断配置（可选，有默认值）─────────────────────────
# 请求体快照最大字节数（默认 2048）
LOG_OP_REQUEST_MAX_BYTES=2048
# 响应体快照最大字节数（默认 4096，AI 服务响应含向量，默认不截取响应体）
LOG_OP_RESPONSE_MAX_BYTES=4096
