{
  "routes": [
    { "method": "POST", "path": "/mock/token", "description": "direct mock token", "response": { "success": true, "message": "token generated", "code": 200, "result": { "token": "{{token}}", "expireAt": "{{expireAt}}", "tokenType": "Bearer", "username": "{{username}}" }, "timestamp": "{{timestamp}}" } },
    { "method": "GET", "path": "/mock/token", "description": "direct mock token by get", "response": { "success": true, "message": "token generated", "code": 200, "result": { "token": "{{token}}", "expireAt": "{{expireAt}}", "tokenType": "Bearer", "username": "{{username}}" }, "timestamp": "{{timestamp}}" } },
    { "method": "POST", "path": "/sys/login", "description": "login", "response": "$ref:user-login.json" },
    { "method": "POST", "path": "/sys/logout", "description": "logout", "response": { "success": true, "message": "logout success", "code": 200, "result": null, "timestamp": "{{timestamp}}" } },
    { "method": "POST", "path": "/sys/selectDepart", "description": "select depart", "requireAuth": true, "response": "$ref:user-login.json" },
    { "method": "PUT", "path": "/sys/selectDepart", "description": "select depart", "requireAuth": true, "response": "$ref:user-login.json" },
    { "method": "GET", "path": "/sys/user/getUserInfo", "description": "current user", "requireAuth": true, "response": "$ref:user-info.json" },
    { "method": "GET", "path": "/sys/user/queryListByParam", "description": "users by org", "response": "$ref:user-list.json" },
    { "method": "GET", "path": "/sys/user/queryListByRole", "description": "users by role", "response": "$ref:user-list.json" },
    { "method": "GET", "path": "/sys/user/queryListByXnCode", "description": "users by xn code", "response": "$ref:user-list.json" },
    { "method": "GET", "path": "/basic/peopleInfo/queryList", "description": "people query", "response": "$ref:people-info.json" },
    { "method": "GET", "path": "/basic/peopleInfo/dqdlRyxx", "description": "people detail", "response": { "success": true, "message": "", "code": 200, "result": { "records": [], "total": 0, "size": 10, "current": 1, "pages": 0 }, "timestamp": "{{timestamp}}" } },
    { "method": "GET", "path": "/sys/user/depTree", "description": "dep tree", "response": "$ref:depart-tree.json" },
    { "method": "GET", "path": "/sys/sysDepart/queryDepartTreeSync", "description": "depart tree sync", "response": "$ref:depart-list.json" },
    { "method": "GET", "path": "/sys/sysDepart/getDepartName", "description": "depart info", "response": "$ref:depart-info.json" },
    { "method": "GET", "path": "/sys/sysDepart/queryDepartListV2", "description": "depart list v2", "response": { "success": true, "message": "", "code": 200, "result": [], "timestamp": "{{timestamp}}" } },
    { "method": "GET", "path": "/basic/sysDepart/getDepartChildByDepartId", "description": "depart children", "response": { "success": true, "message": "", "code": 200, "result": [], "timestamp": "{{timestamp}}" } },
    { "method": "GET", "path": "/sys/sysDepart/searchBy", "description": "search depart", "response": { "success": true, "message": "", "code": 0, "result": [], "timestamp": "{{timestamp}}" } },
    { "method": "GET", "path": "/sys/role/list", "description": "role list", "response": "$ref:role-list.json" },
    { "method": "GET", "path": "/sys/permission/getUserPermissionByToken", "description": "permission info", "requireAuth": true, "response": "$ref:permission.json" },
    { "method": "GET", "path": "/sys/permission/getPermCode", "description": "permission code", "requireAuth": true, "response": { "success": true, "message": "", "code": 0, "result": [], "timestamp": "{{timestamp}}" } },
    { "method": "GET", "path": "/sys/dict/getDictItems/:code", "description": "dict items", "response": "$ref:dict-items.json" },
    { "method": "GET", "path": "/sys/dict/queryDictItemsByCode", "description": "dict by code", "response": { "success": true, "message": "", "code": 200, "result": [ { "id": "{{randomId}}", "dictId": "{{randomId}}", "dictCode": "mock_dict", "itemText": "示例项", "itemValue": "demo", "sortOrder": 1, "status": 1 } ], "timestamp": "{{timestamp}}" } },
    { "method": "GET", "path": "/sys/dict/queryAllDictItems", "description": "all dicts", "response": { "success": true, "message": "", "code": 200, "result": { "sex": [ { "value": "1", "text": "男", "title": "男" }, { "value": "2", "text": "女", "title": "女" } ], "depart_category": [ { "value": "1", "text": "单位", "title": "单位" }, { "value": "2", "text": "部门", "title": "部门" } ] }, "timestamp": "{{timestamp}}" } },
    { "method": "GET", "path": "/sys/category/getCategoryByType", "description": "category", "response": "$ref:category.json" },
    { "method": "POST", "path": "/act/process/extActProcess/startProcess", "description": "start process", "response": { "success": true, "message": "", "code": 200, "result": "{{randomId}}", "timestamp": "{{timestamp}}" } },
    { "method": "GET", "path": "/act/process/extActProcess/getProcessDetail", "description": "process detail", "response": { "success": true, "message": "", "code": 200, "result": { "processInstanceId": "{{randomId}}", "status": "running", "startUser": "张三", "startTime": "{{datetime}}" }, "timestamp": "{{timestamp}}" } },
    { "method": "GET", "path": "/gaw/user/getUserInfo", "description": "gaw user info", "response": { "success": true, "message": "", "code": 200, "result": { "code": "{{workNo}}", "sfzh": "{{username}}", "name": "{{realname}}", "departCode": "{{orgCode}}", "departName": "{{orgName}}" }, "timestamp": "{{timestamp}}" } },
    { "method": "GET", "path": "/gaw/org/getOrgInfo", "description": "gaw org info", "response": { "success": true, "message": "", "code": 200, "result": { "parentId": "", "id": "{{randomId}}", "orgCode": "{{orgCode}}", "departName": "{{orgName}}" }, "timestamp": "{{timestamp}}" } },
    { "method": "POST", "path": "/msg/send", "description": "send message", "response": { "success": true, "message": "", "code": 200, "result": "", "timestamp": "{{timestamp}}" } },
    { "method": "POST", "path": "/sys/token/exchange", "description": "token exchange", "response": { "success": true, "message": "", "code": 200, "result": "mock_exchanged_token_{{randomId}}", "timestamp": "{{timestamp}}" } },
    { "method": "GET", "path": "/sys/token/exchange", "description": "token exchange by get", "response": { "success": true, "message": "", "code": 200, "result": "mock_exchanged_token_{{randomId}}", "timestamp": "{{timestamp}}" } },
    { "method": "GET", "path": "/duty/getDutyInfo", "description": "duty info", "response": { "success": true, "message": "", "code": 200, "result": [], "timestamp": "{{timestamp}}" } },
    { "method": "POST", "path": "/jwy/app/token", "description": "jwy app token", "response": { "success": true, "message": "", "code": 200, "result": "mock_app_token_{{randomId}}", "timestamp": "{{timestamp}}" } },
    { "method": "GET", "path": "/jwy/app/token", "description": "jwy app token by get", "response": { "success": true, "message": "", "code": 200, "result": "mock_app_token_{{randomId}}", "timestamp": "{{timestamp}}" } },
    { "method": "POST", "path": "/jwy/user/token", "description": "jwy user token", "response": { "success": true, "message": "", "code": 200, "result": "mock_user_token_{{randomId}}", "timestamp": "{{timestamp}}" } },
    { "method": "GET", "path": "/jwy/user/token", "description": "jwy user token by get", "response": { "success": true, "message": "", "code": 200, "result": "mock_user_token_{{randomId}}", "timestamp": "{{timestamp}}" } },
    { "method": "GET", "path": "/jwy/user/info", "description": "jwy user info", "response": { "success": true, "message": "", "code": 200, "result": { "code": "{{workNo}}", "sfzh": "{{username}}", "name": "{{realname}}", "departCode": "{{orgCode}}", "departName": "{{orgName}}" }, "timestamp": "{{timestamp}}" } }
  ]
}
